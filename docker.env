# Docker environment – pre-configured for Mock API (no real miniCRM account needed)
# Run: docker compose --profile mock --env-file docker.env up -d --build

# miniCRM credentials – not used in mock mode
MINICRM_SYSTEM_ID=not-required-for-mock
MINICRM_API_KEY=not-required-for-mock

# Points all services to the Mock API container instead of real miniCRM
MINICRM_BASE_URL=http://mock-api:5090

# Gateway API key – used to authorize requests in Swagger and MCP server
# Must match: minicrm-mcp/.env GATEWAY_API_KEY and claude_desktop_config.json GATEWAY_API_KEY
GATEWAY_API_KEY=minicrm-gateway-2026-secure-key
