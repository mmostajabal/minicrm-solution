# ── miniCRM API Gateway ───────────────────────────────────────────────────────
# URL of the running API Gateway (default: http://localhost:5000)
GATEWAY_URL=http://localhost:5000

# The same key configured in minicrm-gateway/appsettings.json → Gateway:GatewayApiKey
GATEWAY_API_KEY=2xv4qJEpPBa5gdwe1mSGR6YyIiWUNKjf

# ── Language ─────────────────────────────────────────────────────────────────
# Tool descriptions and response messages language.
# Supported: hu (Hungarian / Magyar, default) | en (English)
LANGUAGE_ID=hu

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: error | warn | info | debug  (default: info)
LOG_LEVEL=info

# Log file path (leave empty to disable file logging)
LOG_FILE=logs/minicrm-mcp.log
