# Copy this file to docker.env and fill in your values
# Usage: docker compose --env-file docker.env up -d

# miniCRM API credentials (required for real API mode)
MINICRM_SYSTEM_ID=YOUR_SYSTEM_ID
MINICRM_API_KEY=YOUR_API_KEY

# To use Mock API instead of real miniCRM, set:
# MINICRM_BASE_URL=http://mock-api:5090
# Then start with: docker compose --profile mock --env-file docker.env up -d

# Gateway API key — must match what you use in MCP .env
GATEWAY_API_KEY=choose-a-strong-random-key
