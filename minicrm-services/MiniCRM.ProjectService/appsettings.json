{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/projects-.log", "rollingInterval": "Day" } }
    ]
  },

  "MiniCRM": {
    "BaseUrl":  "https://r3.minicrm.hu",
    "SystemId": "YOUR_SYSTEM_ID",
    "ApiKey":   "YOUR_API_KEY"
  },

  "AllowedHosts": "*"
}
